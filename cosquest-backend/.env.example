PORT=6893
NODE_ENV=development
JWT_SECRET=replace-with-a-long-random-secret
MONGODB_URI=mongodb://127.0.0.1:27017/cosquest

# Required. Backs the Socket.IO cross-instance adapter (src/realtime/socket.js),
# live presence (src/realtime/presence.js), and the auth rate limiters
# (src/middleware/rateLimiter.js) - see README "Real-time: WebSockets + Redis".
# `npm test` doesn't need this set - it spins up its own ephemeral Redis.
REDIS_URL=redis://127.0.0.1:6379

# Fallback dashboard area only, used until a user's own onboarding-captured
# coordinates exist (see User.location / PATCH /api/users/me/preferences/location).
# Every account that completes onboarding now has real coordinates of its own.
DASHBOARD_DEFAULT_LAT=6.5244
DASHBOARD_DEFAULT_LNG=3.3792
DASHBOARD_RADIUS_MILES=30

# Optional. Shareable profile links (see GET /api/users/:username/share and
# GET /u/:username) default to this backend's own /u/:username page if unset -
# already fully working with rich social previews. Only set this if a
# separate web frontend takes over hosting that public page instead, e.g.
# PUBLIC_PROFILE_BASE_URL=https://cosquest.app/profile
PUBLIC_PROFILE_BASE_URL=

# Origin of this backend for /p/:postId and /c/:conversationId share pages.
# Set the public HTTPS origin in production (especially behind a proxy).
PUBLIC_BASE_URL=
# Optional web-app base URL. Chat/post share pages link to matching app routes.
# The frontend must handle /chats/:id/messages/:id and /posts/:id after sign-in.
APP_WEB_URL=

# Help & Support destinations; absent values are returned as null.
HELP_FAQ_URL=
HELP_SUPPORT_URL=
TERMS_URL=
PRIVACY_POLICY_URL=

# Keep these private: use them only in the backend .env file.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Preset avatar delivery IDs are maintained by the backend mapping file.
# User-uploaded profile photos are kept separate from the preset avatars.
CLOUDINARY_PROFILE_PHOTO_FOLDER=cosquest/cosquest profile-photos
CLOUDINARY_POST_IMAGE_FOLDER=cosquest/posts
CLOUDINARY_REEL_FOLDER=cosquest/reels
# Avatar picker: GET /api/meta/avatars asks Cloudinary what exists (needs the
# API key/secret above). With none of these set, every image in the account
# counts except the app's own cosquest/ upload folders and Cloudinary's demo
# images. To be strict, tag your avatars in Cloudinary and set ONE of:
# CLOUDINARY_AVATAR_TAG=avatar
# CLOUDINARY_AVATAR_PREFIX=avatars/
# The listing is cached (default 600s) because Cloudinary's Admin API is rate limited.
# CLOUDINARY_AVATAR_CACHE_SECONDS=600

# OAuth: backend redirects here after Google/Apple sign-in, with ?oauthCode=...
# and &onboardingRequired=true|false appended. This is NOT registered anywhere
# with Google/Apple - it just needs to be something your own frontend/mobile
# app can handle. A real website route works (https://app.cosquest.app/auth/callback);
# a mobile app typically uses its own registered custom URL scheme instead, e.g.
# cosquest://oauth/callback - placeholders below, replace with your real one.
# This is only the FALLBACK: the app/website normally passes its own address as
# /api/auth/oauth/google?redirectUri=..., and that is used instead when it
# starts with cosquest:// or is on https://cosquest.vercel.app/. Anything else
# is ignored and this fallback is used. Suggested value: cosquest://onboarding/oauthGoogle
OAUTH_SUCCESS_REDIRECT_URL=cosquest://oauth/callback
OAUTH_COOKIE_SECRET=replace-with-a-second-long-random-secret

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Must exactly match an "Authorized redirect URI" configured for this client
# in Google Cloud Console (APIs & Services > Credentials) - changing this value
# here does nothing on its own; add the same URL there too, or Google returns
# redirect_uri_mismatch. Placeholder below - swap in your real backend domain.
GOOGLE_OAUTH_CALLBACK_URL=https://api.cosquest.app/api/auth/oauth/google/callback

APPLE_OAUTH_CLIENT_ID=
APPLE_OAUTH_TEAM_ID=
APPLE_OAUTH_KEY_ID=
# Paste the .p8 key on one line, replacing real line breaks with \n.
APPLE_OAUTH_PRIVATE_KEY=
# Must be a public HTTPS endpoint registered in Apple Developer > Sign in with
# Apple as a Return URL, exactly matching this value. Placeholder below.
APPLE_OAUTH_CALLBACK_URL=https://api.cosquest.app/api/auth/oauth/apple/callback

# Voice-note transcription (Deepgram Nova-2)
DEEPGRAM_API_KEY=

# Sparks (optional): lets Claude write Spark subjects and summaries. Without it
# a simple built-in summary is used. SPARKS_AI_MODEL overrides the model.
ANTHROPIC_API_KEY=
SPARKS_AI_MODEL=

# Audio/video calls (LiveKit server credentials; never expose the secret to clients)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Sparks engine: legacy (default, the keyword stand-in) or module (the real Sparks:
# detection on members' phones through the SDK). Switch to module once the Expo app
# ships the SDK, or once the server fallback worker runs. See SPARKS_INTEGRATION.md.
SPARKS_ENGINE=legacy
# Where phones download the on-device model from: the manifest the Sparks team hosts.
# GET /v1/model redirects here (and keeps the ?mq=5 query the 1.2 SDK sends). No space after the =.
SPARKS_MODEL_MANIFEST_URL=
